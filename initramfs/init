#!/bin/sh
# BaseOS early userspace. Keep the vendor filesystem contract: repair ext4
# before mounting, retain its journal/mount flags, and move devtmpfs into root.
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs none /dev

boot_mark()
{
	read -r boot_uptime boot_idle < /proc/uptime
	printf '%s\t%s\t%s\n' "$boot_uptime" "$1" "${2:-}" >> /dev/.baseos-boot-profile.tsv
}
boot_mark initramfs.start minimal
exec < /dev/console > /dev/console 2>&1

ROOT_DEVICE=autoconfig
CONSOLE_DEVICE=ttyS0
GPT_SUPPORT=
read -r kernel_cmdline < /proc/cmdline
set -f
for parm in $kernel_cmdline; do
	case "$parm" in
	root=*) ROOT_DEVICE=${parm#root=} ;;
	console=*) CONSOLE_DEVICE=${parm#console=}; CONSOLE_DEVICE=${CONSOLE_DEVICE%%,*} ;;
	gpt=*) GPT_SUPPORT=${parm#gpt=} ;;
	esac
done
set +f

if [ "$GPT_SUPPORT" = 1 ]; then
	NAND_DEF_DEVICE=nand0p5
	SDMMC_DEF_DEVICE=mmcblk0p5
else
	NAND_DEF_DEVICE=nandd
	SDMMC_DEF_DEVICE=mmcblk0p7
fi

# The original BusyBox provides usleep. Keep a finite 10-second timeout while
# avoiding a whole extra second when devtmpfs becomes ready just after a check.
wait_for_ready()
{
	ready_tries=200
	while [ ! -b "$1" ]; do
		[ "$ready_tries" -gt 0 ] || return 1
		usleep 50000 || return 1
		ready_tries=$((ready_tries - 1))
	done
	boot_mark initramfs.devices.ready "$1"
}

do_mount()
{
	boot_mark initramfs.fsck.start "$1"
	e2fsck -y "$1"
	fsck_rc=$?
	boot_mark initramfs.fsck.done "rc=$fsck_rc device=$1"
	case "$fsck_rc" in
	0|1) ;;
	2|3)
		# e2fsck requests a reboot after these repair results.
		boot_mark initramfs.reboot "fsck_rc=$fsck_rc"
		sync
		reboot -f
		return 1
		;;
	*)
		echo "BaseOS: e2fsck failed for $1 (status $fsck_rc); entering recovery"
		return 1
		;;
	esac
	boot_mark initramfs.root.mount.start "$1"
	mount -o rw,noatime,nodiratime,norelatime,noauto_da_alloc,barrier=0,data=ordered -t ext4 "$1" /mnt
	mount_rc=$?
	boot_mark initramfs.root.mount.done "rc=$mount_rc device=$1"
	return "$mount_rc"
}

do_mount_nor()
{
	boot_mark initramfs.root.mount.start "$1"
	mount -t squashfs "$1" /mnt
	mount_rc=$?
	boot_mark initramfs.root.mount.done "rc=$mount_rc device=$1"
	return "$mount_rc"
}

load_nand()
{
	# Retain the vendor fallback for targets whose root lives on NAND.
	NAND_MODULE=/lib/modules/$(uname -r)/nand.ko
	insmod "$NAND_MODULE"
	wait_for_ready "$1" && do_mount "$1"
}

load_emmc()
{
	wait_for_ready "$1" && do_mount "$1"
}

case "$ROOT_DEVICE" in
/dev/nand*|/dev/system) load_nand "$ROOT_DEVICE" ;;
/dev/mmc*) load_emmc "$ROOT_DEVICE" ;;
/dev/mtd*) do_mount_nor "$ROOT_DEVICE" ;;
autoconfig*)
	# Preserve the stock autodetection fallback. The normal H700 boot command
	# supplies root=/dev/mmcblk0p5 and does not enter this branch.
	sleep 1
	if cat /proc/partitions | grep "$SDMMC_DEF_DEVICE" > /dev/null; then
		magic_num=$(hexdump -s 1292 -n 2 -x /dev/"$SDMMC_DEF_DEVICE" | head -1 | awk '{print $2}')
		if [ "$magic_num" != f30a ]; then
			load_emmc /dev/"$SDMMC_DEF_DEVICE"
		fi
	else
		load_nand /dev/"$NAND_DEF_DEVICE"
	fi
	;;
*) echo "BaseOS: unsupported root device $ROOT_DEVICE" ;;
esac

if [ -x /mnt/init ]; then
	boot_mark initramfs.switch_root "$ROOT_DEVICE"
	mount -o noatime,move /dev /mnt/dev && exec switch_root /mnt /init
fi
boot_mark initramfs.recovery "$ROOT_DEVICE"
echo "BaseOS: root boot failed; recovery shell on $CONSOLE_DEVICE"
while true; do
	getty -L "$CONSOLE_DEVICE" 115200 vt100 -n -l /bin/ash
	sleep 1
done
