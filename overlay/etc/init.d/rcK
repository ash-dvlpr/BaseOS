#!/bin/sh
# BusyBox runs shutdown actions before its process-kill sweep. Stop writers
# first; init starts rcK in its own session, which killall5 preserves.
/usr/bin/busybox killall5 -TERM
/bin/sleep 1
/usr/bin/busybox killall5 -KILL
/bin/dd if=/dev/urandom of=/data/random-seed bs=512 count=1 2>/dev/null
/sbin/swapoff -a 2>/dev/null
/bin/sync

# The marker distinguishes poweroff from reboot. axp-off checks the PMIC and
# requires every persistent filesystem (including /) to be read-only before
# cutting power. Any refusal returns to BusyBox's normal kernel shutdown.
if [ -e /run/poweroff-requested ] && [ -x /usr/sbin/axp-off ]; then
	/usr/sbin/axp-off --now
fi
/bin/umount -a -r 2>/dev/null
