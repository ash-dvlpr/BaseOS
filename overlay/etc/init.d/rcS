#!/bin/sh
# H700 base OS early init. Normal-boot budget: well under one second — no
# sleeps, anything slow runs in the background. The requested USB-storage path
# may wait briefly for TF2 enumeration, and the charger branch's `sleep 5` runs
# only where a PMIC write did not take, on a boot that was ending anyway.
# Root filesystem is read-only; all writable state is tmpfs or /data (p6, ext4).

/bin/mount -t proc -o nodev,noexec,nosuid proc /proc
/bin/mount -t sysfs -o nodev,noexec,nosuid sys /sys
# The SP vendor kernels expose a low-power suspend policy switch. Stock applies
# its persisted Super Standby bit as value 16; non-SP kernels have no such file
# and already fully stop their USB host controllers during `mem` suspend.
os_sleep=/sys/class/power_supply/axp2202-battery/os_sleep
[ -w "$os_sleep" ] && printf '16' > "$os_sleep"
grep -q ' /dev devtmpfs ' /proc/mounts || /bin/mount -t devtmpfs dev /dev
/bin/mkdir -p /dev/pts /dev/shm
/bin/mount -t devpts -o gid=5,mode=620 devpts /dev/pts
# debugfs: the sunxi disp2 driver's only display-output control surface is
# /sys/kernel/debug/dispdbg — it is what switches disp0 between the LCD and the
# HDMI TX. The stock OS got this mount for free from systemd; without it the
# frontend's HDMI switch silently no-ops and a plugged-in TV stays dark while
# the 720p UI is scaled onto the internal panel (issue #10).
/bin/mount -t debugfs -o nodev,noexec,nosuid debugfs /sys/kernel/debug
/bin/mount -t tmpfs -o mode=1777,size=256m tmpfs /dev/shm
/bin/mount -t tmpfs -o mode=1777,size=256m tmpfs /tmp
/bin/mount -t tmpfs -o mode=755,size=32m tmpfs /run
/bin/cut -d" " -f1 /proc/uptime > /run/boot-rcS-start
/bin/mount -t tmpfs -o mode=755,size=64m tmpfs /var

# /var skeleton (tmpfs). Persistent pieces live on /data and are linked below.
/bin/mkdir -p /var/lib /var/log /var/tmp /var/lib/alsa /var/lib/bluealsa /var/empty
/bin/ln -s /run /var/run

/bin/hostname -F /etc/hostname

# GPU: needed by the frontend's first frame (~2s away), not before, and the
# insmod costs ~0.7s. Load it in the background so it overlaps the card mount
# and launch.sh; nextui-session waits for /dev/mali0 before handing off.
/sbin/insmod /lib/modules/mali_kbase.ko 2>/dev/null &

# Persistent state partition (p6, label "userdata"). It survives system
# updates: an A/B slot flip only moves the rootfs partition.
/bin/mkdir -p /data
if ! /bin/mount -t ext4 -o rw,noatime /dev/mmcblk0p6 /data 2>/dev/null; then
	/bin/mount -t tmpfs tmpfs /data
fi
/bin/mkdir -p /data/bluetooth /data/bluealsa /data/dropbear
/bin/ln -sfn /data/bluetooth /var/lib/bluetooth

# A charger boot is not a session, so end it here.
#
# The PMIC brings the rails up whenever VBUS appears. That is normal vendor
# behaviour, not a fault, and U-Boot records the cause on the cmdline
# (bootreason=charger, mirrored at axp2202-battery/boot_mode). Left alone it
# runs all the way into the frontend, so plugging a powered-off handheld in to
# charge leaves it awake for hours competing with its own charger —
# knulli-cfw/distribution#287 is the same fault on an RG35XX SP. Powering off
# again charges properly instead; POWER yields bootreason=button and a normal
# boot with the cable still attached, which is what keeps adb reachable.
#
# Placed before `baseos-update boot-check` on purpose: a charger boot never
# reaches a frontend session, so counting it as a failed trial boot would roll
# back a perfectly good update on a device that merely gets charged often. It is
# also ahead of the card mount, expand-storage and the frontend, so nothing is
# mounted or written that a power cut could tear.
#
# Six preconditions, each guarding a way this could be worse than the fault.
# The first test is the cmdline grep, so a normal boot leaves the rest of them
# unevaluated:
#
#   * /data must be the real partition. On the tmpfs fallback nothing can be
#     remembered between boots, and an unbounded loop beats a hung frontend.
#   * /data/no-charger-off opts out entirely. This hardware cannot distinguish a
#     host PC from a dumb charger — the driver publishes no usb_type and BC
#     detection reads empty — so anyone who wants a cable-attached boot to come
#     all the way up needs a switch, and this is it.
#   * MENU must not be held. For a powered-off device, connecting the cable *is*
#     the power-on — that is the whole fault above — so without this test the
#     documented USB mass-storage recovery ("connect the cable, then hold MENU
#     from power-on", 08-usb-adb-and-otg.md) would power the device off before
#     rcS ever looked at the button. That is the path a user reaches for exactly
#     when the device is otherwise unusable. debugfs is mounted far above, so
#     this is one sub-millisecond grep, and only on a charger boot. Guarded on
#     -x like the storage-mode call site below: a missing helper must not make
#     the branch unreachable, only unable to see the button.
#   * axp-off must say it can work on this board. Unarmed it writes nothing and
#     returns 0 only after discovery succeeded, the address and the part name
#     matched, /dev/i2c-N opened and REG27H read — an exact "can this work here"
#     test. One AXP part has been measured, on an RG SP, and the name allowlist
#     holds only that one; anywhere the probe fails this branch logs that to
#     charger.log and falls through before anything is unmounted, so a
#     maintainer debugging a board that never stays off has somewhere to look.
#   * The RTC must give a usable time, since it is the only way to recognise a
#     loop. No clock, no power off.
#   * The previous auto-off must not have been seconds ago. If the PMIC write
#     ever stops sticking, the next pass boots normally rather than cycling
#     forever. Deliberate replugs are minutes apart and unaffected.
CHARGER_LOOP_WINDOW=120
if /bin/grep -q 'bootreason=charger' /proc/cmdline 2>/dev/null \
	&& /bin/grep -q ' /data ext4 ' /proc/mounts \
	&& [ ! -e /data/no-charger-off ] \
	&& ! { [ -x /usr/sbin/boot-menu-held ] && /usr/sbin/boot-menu-held; }; then
	if [ -x /usr/sbin/axp-off ] && /usr/sbin/axp-off >/dev/null 2>&1; then
		charger_now="$(/bin/cat /sys/class/rtc/rtc0/since_epoch 2>/dev/null)"
		charger_last="$(/bin/cat /data/charger-off-stamp 2>/dev/null)"
		case "$charger_now" in ''|*[!0-9]*|0?*|???????????*) charger_now=0 ;; esac
		case "$charger_last" in ''|*[!0-9]*|0?*|???????????*) charger_last=0 ;; esac
		# charger.log is append-only and unbounded, deliberately: one short line per
		# charger boot is the only record of a decision taken with no screen, no
		# frontend and no adb, and rotating it would cost a stat on the boot path.
		charger_log="$(/bin/cut -d' ' -f1 /proc/uptime) rtc=$charger_now last=$charger_last"

		if [ "$charger_now" -eq 0 ]; then
			echo "$charger_log no usable RTC, booting normally" >> /data/charger.log
		elif [ "$charger_last" -gt 0 ] \
			&& [ "$((charger_now - charger_last))" -ge 0 ] \
			&& [ "$((charger_now - charger_last))" -lt "$CHARGER_LOOP_WINDOW" ]; then
			echo "$charger_log inside loop window, booting normally" >> /data/charger.log
		else
			# The stamp write is the gate, not an afterthought: errors=remount-ro can
			# leave /data mounted ext4 but unwritable, which the precondition above
			# does not catch (it tests filesystem type, not writability). Silently
			# powering off in that state would mean the loop guard's own memory never
			# lands, and the next charger boot would have nothing to compare against —
			# an unbounded loop with no adb and no frontend to recover it from.
			#
			# A successful open is not a successful write. A full or dying /data can
			# take the create and land no bytes, and the next boot reads '' from the
			# stamp and maps it to 0 — disarming the loop guard for exactly the cycle
			# that needed it. So the size is checked too.
			#
			# The 2>/dev/null is ungrouped on purpose. A redirection that fails is
			# reported by the shell *before* that redirection is applied, so the
			# message still reaches the console; grouping it would delete that. On a
			# device whose /data is unwritable every >> append in this branch is
			# failing too, which makes that one line the only surviving evidence that
			# the device chose to boot rather than power off.
			if ! echo "$charger_now" > /data/charger-off-stamp 2>/dev/null \
				|| [ ! -s /data/charger-off-stamp ]; then
				echo "$charger_log cannot record the loop stamp, booting normally" >> /data/charger.log
			else
				echo "$charger_log powering off to charge" >> /data/charger.log
				/bin/sync
				# Close /data before the rails drop. sync flushes the writes but leaves
				# the filesystem marked in use, so cutting power here would replay the
				# journal on every subsequent mount. Nothing else is mounted yet, which
				# is the whole reason this branch sits where it does.
				/bin/umount /data 2>/dev/null \
					|| /bin/mount -o remount,ro /data 2>/dev/null
				/usr/sbin/axp-off --now
				# Give a successful cut time to land: axp-off returns as soon as the
				# i2c write completes, milliseconds before the rails actually drop, and
				# nothing below here should race that gap the way the umount above
				# exists to avoid. On a successful cut this sleep never completes;
				# reaching the remount below means the write did not take within five
				# seconds.
				/bin/sleep 5
				# Put /data back before falling through, or the rest of this boot runs
				# without its state partition. The stamp above means the next charger
				# boot will not retry immediately.
				/bin/mount -t ext4 -o rw,noatime /dev/mmcblk0p6 /data 2>/dev/null \
					|| /bin/mount -o remount,rw /data 2>/dev/null
				echo "$charger_log PMIC off did not take, continuing" >> /data/charger.log
			fi
		fi
	else
		# Discovery failed, the address or the part name did not match, or REG27H
		# was unreadable — expected on every H700 model but the RG SP. Log it once
		# so a maintainer debugging a board that never stays off has somewhere to
		# look, and fall through: nothing has been unmounted yet.
		echo "$(/bin/cut -d' ' -f1 /proc/uptime) PMIC path unavailable on this board, booting normally" >> /data/charger.log
	fi
fi

# A freshly updated slot is on trial until a frontend session starts. Count the
# boots that never got that far and restore the previous slot if this one
# cannot. No-op unless an update is in its trial window.
[ -x /usr/sbin/baseos-update ] && /usr/sbin/baseos-update boot-check

# Restore the selected timezone. /etc/localtime is baked as a symlink to
# /run/localtime because the root filesystem is read-only; timedatectl keeps
# the selected zone name on the persistent /data partition.
[ -x /usr/bin/timedatectl ] && /usr/bin/timedatectl apply 2>/dev/null

# Entropy: restore last boot's seed (kernel 4.9 is slow to gather on its own).
[ -f /data/random-seed ] && /bin/cat /data/random-seed > /dev/urandom 2>/dev/null

# System clock from RTC (stock delegated this to systemd; rc.local had it disabled).
# -u is mandatory: the RTC holds UTC (baseos-ntp-notify writes it with -u -w), and
# absent that flag busybox reads the RTC as local time and rewinds the clock by the
# zone offset, so the frontend shows UTC until ntpd corrects it minutes later. The
# usual alternative — an adjtime file declaring UTC — cannot work here: this
# busybox looks for it at /var/lib/hwclock/adjtime, and /var is tmpfs.
/sbin/hwclock -u -s 2>/dev/null &

# WiFi: BaseOS owns the wlan0 interface so a frontend never has to wait for it
# (removing any dependency on the frontend's wifi script being race-hardened).
# Loading the module triggers an asynchronous SDIO probe that creates wlan0 a
# couple of seconds later; a background task waits for it and brings it up
# (rfkill-unblock + link up). The frontend then only runs wpa_supplicant/DHCP on
# an already-present, up interface. `ip`/`rfkill` are busybox applets on PATH.
(
	/sbin/insmod /lib/modules/8821cs.ko 2>/dev/null
	wifi_wait=0
	while [ ! -d /sys/class/net/wlan0 ] && [ "$wifi_wait" -lt 40 ]; do
		sleep 0.25 2>/dev/null || sleep 1
		wifi_wait=$((wifi_wait + 1))
	done
	if [ -d /sys/class/net/wlan0 ]; then
		rfkill unblock wifi 2>/dev/null || true
		ip link set wlan0 up 2>/dev/null || true
	fi
) &

# machine-id (dbus/BlueZ). /etc/machine-id is a baked symlink into /run.
if [ -s /data/machine-id ]; then
	/bin/cp /data/machine-id /run/machine-id
else
	/usr/bin/dbus-uuidgen > /run/machine-id 2>/dev/null \
		|| /bin/tr -d - < /proc/sys/kernel/random/uuid > /run/machine-id
	/bin/cp /run/machine-id /data/machine-id 2>/dev/null
fi
/bin/mkdir -p /run/dbus /var/lib/dbus
/bin/ln -sf /run/machine-id /var/lib/dbus/machine-id

# First boot on a fresh flash: grow this card's data partition to fill the
# whole card (leaving it empty for the user to add a frontend). No-op once the
# card already fills the disk.
[ -x /usr/sbin/expand-storage ] && /usr/sbin/expand-storage

# MENU held from power-on selects a one-boot USB-storage maintenance mode. Check
# the current evdev state once: no timing window, input loop, or normal-boot
# delay. Because no frontend card has been mounted yet, TF2 can be exported as
# a complete disk (partition table included); without TF2, export TF1's p7.
USB_STORAGE_MODE=0
/bin/mkdir -p /mnt/sdcard
if [ -x /usr/sbin/boot-menu-held ] \
	&& /usr/sbin/boot-menu-held \
	&& [ -x /usr/sbin/usb-storage-mode ] \
	&& /usr/sbin/usb-storage-mode prepare; then
	USB_STORAGE_MODE=1
fi

# Normal boot mounts the frontend/data card: TF2 p1 wins if usable, else this
# card's own "primary" FAT partition (p7).
if [ "$USB_STORAGE_MODE" -eq 0 ]; then
	for dev in /dev/mmcblk1p1 /dev/mmcblk0p7; do
		[ -b "$dev" ] || continue
		if /bin/mount -t vfat -o rw,utf8,noatime,shortname=mixed "$dev" /mnt/sdcard 2>/dev/null \
			|| /bin/mount -t exfat -o rw,noatime "$dev" /mnt/sdcard 2>/dev/null; then
			break
		fi
		# One repair attempt, then retry once.
		/usr/sbin/fsck.fat -a "$dev" >/dev/null 2>&1
		if /bin/mount -t vfat -o rw,utf8,noatime,shortname=mixed "$dev" /mnt/sdcard 2>/dev/null \
			|| /bin/mount -t auto "$dev" /mnt/sdcard 2>/dev/null; then
			break
		fi
	done

	# Boot breadcrumb on the card (readable from any computer).
	if /bin/mountpoint -q /mnt/sdcard 2>/dev/null; then
		echo "$(/bin/cut -d' ' -f1 /proc/uptime) rcS reached card mount" >> /mnt/sdcard/baseos-boot.log
	fi
fi
/bin/ln -sfn /mnt/sdcard /mnt/SDCARD

# System update: apply a *.bosupd payload the user copied onto the card. Costs
# one failed glob on an ordinary boot; when a payload is present it writes the
# inactive rootfs slot, verifies it, flips the GPT and reboots. Storage mode
# leaves every card file to the USB host; the update runs on the next normal
# boot after the user ejects and restarts without MENU.
if [ "$USB_STORAGE_MODE" -eq 0 ]; then
	[ -x /usr/sbin/baseos-update ] && /usr/sbin/baseos-update apply
fi

# Dev image extras (serial getty is in inittab; this starts SSH).
[ -x /etc/init.d/dev ] && /etc/init.d/dev &

/bin/cut -d" " -f1 /proc/uptime > /run/boot-rcS-done

: # rcS must succeed; init proceeds to respawn nextui-session
