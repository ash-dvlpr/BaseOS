#!/bin/sh
# Optional hostname override, triggered by a file on the card root.
#
# Commands:
#   apply    after machine-id is set: choose the persisted /data/hostname if
#            available, otherwise the baked default, then apply it and
#            regenerate the /run copies of /etc/hostname and /etc/hosts.
#
#   consume  after the card is mounted: validate <card>/rename_hostname,
#            persist it to /data/hostname, apply it, regenerate the /run
#            mirrors, remove the card file, and report that a reboot is needed
#            so the next boot's `apply` names every service from the outset.
#
# The root filesystem is assumed to be read-only. The hostname lives on the
# persistent /data partition, and /etc/hostname + /etc/hosts are baked
# symlinks into /run that these commands regenerate. The card file is consumed
# once, so editing it again is how the name is changed. No hostname-aware
# services must have started before calling any of these commands; all daemons
# that make use of the hostname should start after the `apply` call, so that no
# service restarts are needed.
#
# consume exit codes:
#   0 = a rename was consumed (caller should reboot)
#   1 = nothing to do (no file, or the file could not be removed)
#   2 = invalid rename file
set -eu

DATA_DIR="${BASEOS_DATA_DIR:-/data}"
SD="${BASEOS_SDCARD_DIR:-/mnt/sdcard}"
RENAME_FILE="${BASEOS_RENAME_FILE:-$SD/rename_hostname}"
PERSIST="$DATA_DIR/hostname"
HOSTNAME_BIN="${BASEOS_HOSTNAME_BIN:-/bin/hostname}"
LOG="${BASEOS_HOSTNAME_LOG:-/tmp/rename-hostname.log}"

# Runtime data for the baked /etc/hostname and /etc/hosts symlinks.
RUN_HOSTS="${BASEOS_HOSTS_FILE:-/run/hosts}"
RUN_HOSTNAME="${BASEOS_RUN_HOSTNAME:-/run/hostname}"
HOSTS_TEMPLATE="${BASEOS_HOSTS_TEMPLATE:-/usr/share/baseos/hosts.template}"
DEFAULT_HOSTNAME_FILE="${BASEOS_DEFAULT_HOSTNAME_FILE:-/usr/share/baseos/default-hostname}"

log() {
	line="$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo 0) rename-hostname: $*"
	echo "$line" >> "$LOG" 2>/dev/null || true
	return 0
}

# Validate the rules from hostname(7): Valid characters for hostnames are ASCII letters
# from a to z, the digits from 0 to 9, and the hyphen (-).  A hostname may not
# start nor end with a hyphen.
valid_hostname() {
	hostname="$1"

	# Total length: 1-63 ASCII characters
	[ -n "$hostname" ] || return 1
	[ "${#hostname}" -le 63 ] || return 1

	# Validate there are no leading/trailing hyphens
	case "$hostname" in
		-*|*-) return 1 ;;
		*[!A-Za-z0-9-]*) return 1 ;;
	esac
	return 0
}

# First line only, with CR/LF and surrounding whitespace stripped, so a file
# copied from Windows works.
read_hostname() {
	head -n 1 "$1" 2>/dev/null | 
		tr -d '\r\n' |
		sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# Regenerate the runtime hostname files from a valid hostname_file ($1)
#
# This function is deliberately only responsible for the files. The kernel
# hostname is applied by apply_hostname().
#
# The files are replaced atomically through temporary files.
write_runtime_hostname_files() {
	hostname_file="$1"

	tmp_hostname="$RUN_HOSTNAME.$$"
	tmp_hosts="$RUN_HOSTS.$$"

	# Prepare both files completely before applying anyone of them
	trap 'rm -f "$tmp_hostname" "$tmp_hosts"' EXIT HUP INT TERM

	# Prepare hostname file
	if ! cp "$hostname_file" "$tmp_hostname" 2>/dev/null \
		|| ! chmod 644 "$tmp_hostname" 2>/dev/null
	then
		rm -f "$tmp_hostname" 2>/dev/null || true
		trap - EXIT HUP INT TERM
		log "could not prepare runtime hostname file from '$hostname_file'"
		return 1
	fi

	# Prepare hosts file from the template
	hostname="$(read_hostname "$hostname_file")"
	if ! awk -v name="$hostname" \
		'{ gsub(/@HOSTNAME@/, name); print }' \
		"$HOSTS_TEMPLATE" > "$tmp_hosts" 2>/dev/null \
		|| ! chmod 644 "$tmp_hosts" 2>/dev/null
	then
		rm -f "$tmp_hostname" "$tmp_hosts" 2>/dev/null || true
		trap - EXIT HUP INT TERM
		log "could not prepare runtime hosts file for '$hostname'"
		return 1
	fi

	# Apply finalized hostname and hosts files
	if ! mv -f "$tmp_hostname" "$RUN_HOSTNAME" 2>/dev/null \
		|| ! mv -f "$tmp_hosts" "$RUN_HOSTS" 2>/dev/null
	then
		rm -f "$tmp_hostname" "$tmp_hosts" 2>/dev/null || true
		trap - EXIT HUP INT TERM
		log "could not replace runtime hostname files for '$hostname'"
		return 1
	fi

	trap - EXIT HUP INT TERM
	return 0
}

# Apply the specified hostname file ($1) to the running system.
#
# Failure to update the runtime files makes the hostname application itself fail,
# since it may been left in an unknown state.
apply_hostname() {
	hostname_file="$1"

	if ! "$HOSTNAME_BIN" -F "$hostname_file" 2>/dev/null; then
		log "could not apply hostname from '$hostname_file'"
		return 1
	fi

	if ! write_runtime_hostname_files "$hostname_file"; then
		log "could not update runtime files from '$hostname_file'"
		return 1
	fi

	return 0
}

apply_persisted() {
	if [ -s "$PERSIST" ]; then
		apply_hostname "$PERSIST" || {
			log "could not apply persisted hostname; using default"
			apply_hostname "$DEFAULT_HOSTNAME_FILE" || true
		}
	else
		apply_hostname "$DEFAULT_HOSTNAME_FILE" || true
	fi

	sync
	return 0
}

consume() {
	# If there's no rename trigger file, do nothing
	[ -f "$RENAME_FILE" ] || return 1

	new_hostname="$(read_hostname "$RENAME_FILE")"
	if ! valid_hostname "$new_hostname"; then
		log "invalid hostname in $RENAME_FILE - file left in place"
		return 2
	fi

	if ! mkdir -p "$DATA_DIR" 2>/dev/null; then
		log "could not create data directory $DATA_DIR"
		return 1
	fi

	tmp="$PERSIST.$$"
	trap 'rm -f "$tmp"' EXIT HUP INT TERM

	if ! printf '%s\n' "$new_hostname" > "$tmp" 2>/dev/null \
		|| ! chmod 644 "$tmp" 2>/dev/null \
		|| ! mv -f "$tmp" "$PERSIST" 2>/dev/null
	then
		rm -f "$tmp" 2>/dev/null || true
		trap - EXIT HUP INT TERM
		log "could not persist hostname to $PERSIST"
		return 1
	fi

	trap - EXIT HUP INT TERM

	# Apply the persisted file we just generated.
	if ! apply_hostname "$PERSIST"; then
		log "could not apply hostname from $PERSIST"
		return 1
	fi

	rm -f "$RENAME_FILE" 2>/dev/null || true
	sync

	if [ -e "$RENAME_FILE" ]; then
		log "could not remove $RENAME_FILE - rename applies from $PERSIST next boot"
		return 1
	fi

	log "consumed $RENAME_FILE; reboot required"
	return 0
}

case "${1:-}" in
	apply) apply_persisted ;;
	consume) consume ;;
	*)
		echo "usage: $0 apply|consume" >&2
		exit 2
		;;
esac
