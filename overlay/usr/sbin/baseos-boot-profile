#!/bin/sh
# Sourced by the boot scripts. Create /etc/baseos-boot-profile to enable the
# detailed trace; its contents are ignored. Each marker uses only shell
# builtins and one small append to tmpfs, with no process or clock subprocess.
# The kernel's /proc/uptime clock has 10 ms resolution on this vendor kernel.
# Environment overrides exist so the helper can be tested without mounts.

BASEOS_BOOT_PROFILE_ENABLED=0
BASEOS_BOOT_PROFILE_CONFIG=${BASEOS_BOOT_PROFILE_CONFIG:-/etc/baseos-boot-profile}
BASEOS_BOOT_PROFILE_UPTIME=${BASEOS_BOOT_PROFILE_UPTIME:-/proc/uptime}
BASEOS_BOOT_PROFILE_FILE=${BASEOS_BOOT_PROFILE_FILE:-/run/boot-profile.tsv}
[ ! -e "$BASEOS_BOOT_PROFILE_CONFIG" ] || BASEOS_BOOT_PROFILE_ENABLED=1

baseos_boot_mark() {
	[ "$BASEOS_BOOT_PROFILE_ENABLED" = 1 ] || return 0
	# /dev may not exist yet at the first rcS marker with older ramdisks.
	# Failure to record must never stop boot, or leak errors onto the display.
	{
		IFS=' ' read -r baseos_boot_uptime baseos_boot_idle < "$BASEOS_BOOT_PROFILE_UPTIME" \
			&& printf '%s\t%s\t%s\n' "$baseos_boot_uptime" "$1" "${2:-}" >> "$BASEOS_BOOT_PROFILE_FILE"
	} 2>/dev/null || :
}

baseos_boot_profile_import() {
	# rcS initially shares the initramfs trace on devtmpfs. /run has just been
	# mounted, so import those rows before recording the remaining boot there.
	baseos_boot_early_file=$BASEOS_BOOT_PROFILE_FILE
	BASEOS_BOOT_PROFILE_FILE=$1
	[ "$BASEOS_BOOT_PROFILE_ENABLED" = 1 ] || return 0
	[ "$baseos_boot_early_file" != "$BASEOS_BOOT_PROFILE_FILE" ] || return 0
	if [ -r "$baseos_boot_early_file" ]; then
		{
			while IFS= read -r baseos_boot_line; do
				printf '%s\n' "$baseos_boot_line"
			done < "$baseos_boot_early_file" >> "$BASEOS_BOOT_PROFILE_FILE"
		} 2>/dev/null || :
	fi
}

baseos_boot_legacy_mark() {
	# Retain the three historical /run/boot-* files even with profiling off.
	{
		IFS=' ' read -r baseos_boot_uptime baseos_boot_idle < "$BASEOS_BOOT_PROFILE_UPTIME" \
			&& printf '%s\n' "$baseos_boot_uptime" > "$1"
	} 2>/dev/null || :
}
